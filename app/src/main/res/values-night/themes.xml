<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Night theme fallback maintaining readability -->
    <style name="Base.Theme.MobileComp4b" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_container</item>
        <item name="colorOnPrimary">@color/cream_background</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/cream_background</item>
        <item name="colorSecondary">@color/secondary_green</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="android:colorBackground">@color/cream_background</item>
        <item name="colorSurface">@color/cream_background</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:windowBackground">@color/cream_background</item>
        <item name="android:statusBarColor">@color/cream_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary_forest</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_rentease_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.MobileComp4b</item>
    </style>

    <style name="Theme.MobileComp4b.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash_gradient</item>
        <item name="android:statusBarColor">#073827</item>
        <item name="android:navigationBarColor">#05281C</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>